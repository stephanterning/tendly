{
  "name": "tendly",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run apps/api/src/db/migrate.integration.test.ts",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test",
    "api:generate": "pnpm --filter @tendly/shared build && pnpm --filter @tendly/api generate && openapi-typescript packages/shared/openapi.json -o packages/shared/src/generated/api.ts",
    "db:generate": "pnpm --filter @tendly/api db:generate",
    "db:migrate": "pnpm --filter @tendly/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.2",
    "typescript": "5.9.3",
    "@types/node": "24.19.2",
    "vitest": "4.1.11",
    "openapi-typescript": "7.13.0"
  }
}
