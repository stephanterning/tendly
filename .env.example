# Copy to .env. Use a strong URL-safe password (for example: openssl rand -hex 32).
POSTGRES_PASSWORD=
PUBLIC_ORIGIN=https://tendly.example.com
TENDLY_VERSION=0.0.0-dev
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
LOG_LEVEL=info

# Separate random secret: openssl rand -hex 32. Preserve with backups.
APP_ENCRYPTION_KEY=
